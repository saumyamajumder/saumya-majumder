# Public site URL — used for canonical, Open Graph, sitemap, robots and JSON-LD.
# Must be set at BUILD time (it is inlined into the static page).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form email delivery via Resend (https://resend.com).
# Without these, the form shows an honest "not connected" message with email/WhatsApp fallbacks.
RESEND_API_KEY=
CONTACT_TO_EMAIL=saumyarulez@gmail.com
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
